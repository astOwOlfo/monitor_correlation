GIT_REPO_NAME=rl-rewardhacking-ext
NFS_DIR=/workspace # Your repo should be cloned in /workspace/rl-rewardhacking
LOCAL_SSD_DIR=/tmp # This is used for caches and venv installation

IS_GPU_ENV=true
TMUX_SESSION_NAME=trainingrun
HF_HUB_CACHE=${LOCAL_SSD_DIR}/_model_cache
VLLM_CONFIG_ROOT=${LOCAL_SSD_DIR}/_vllm_config
VLLM_CACHE_ROOT=${LOCAL_SSD_DIR}/_vllm
PIP_CACHE_DIR=${LOCAL_SSD_DIR}/_pip_cache
TORCH_EXTENSIONS_DIR=${LOCAL_SSD_DIR}/_torch_extensions
CUDA_CACHE_PATH=${LOCAL_SSD_DIR}/_cuda_cache
WANDB_DIR=${NFS_DIR}/${GIT_REPO_NAME}/wandb
UV_CACHE_DIR=${LOCAL_SSD_DIR}/_uv_cache
VENV_DIR=${LOCAL_SSD_DIR}/_uv_venv/${GIT_REPO_NAME}
VIRTUAL_ENV=${VENV_DIR}
UV_USE_ACTIVE_ENV=1

# Set based on number of CPU cores available; impacts coding evaluation speed
MAX_JOBS=24

# Recommended Settings
WANDB_LOG_MODEL=false # Prevent sending model to weights and biases, prefer local storage
WANDB_START_METHOD=thread # Use thread instead of process to avoid issues with wandb
VLLM_WORKER_MULTIPROC_METHOD=spawn
LITELLM_LOG=WARNING
WANDB__SERVICE_WAIT=600
